#!/usr/bin/env bash
# Control the speak-reply plugin's spoken replies (speak-reply.sh next to this file).
#   claude-speak [stop]       stop speech from every session
#   claude-speak off | on     mute or unmute this session (needs SPEAK_SESSION,
#                             set by the /speak-reply:speak command)
#   claude-speak global off | global on
#                             mute or unmute all sessions (survives restarts)
#   claude-speak status       show this session's and the global setting
#   claude-speak stop --hook  stop only this session's speech (reads the hook JSON
#                             on stdin; used by the UserPromptSubmit hook), and
#                             skip the reply to a /speak command
piddir="${XDG_RUNTIME_DIR:-/tmp}/claude-speak-reply"
# shellcheck source=state.sh
. "$(dirname "$0")/state.sh"
session=$(safe_id "$SPEAK_SESSION")

stop_file() {
    [ -f "$1" ] && kill -- -"$(cat "$1")" 2>/dev/null
    rm -f "$1"
}

stop_all() {
    for f in "$piddir"/*.pid; do stop_file "$f"; done
    spd-say -C 2>/dev/null
    return 0
}

need_session() {
    [ -n "$session" ] && return 0
    echo "no session id here; use 'global on' or 'global off', or run it as /speak-reply:speak in a session" >&2
    exit 2
}

set_session() {
    need_session
    mkdir -p "$sessiondir" && echo "$1" > "$sessiondir/$session"
}

status() {
    local g; g=$(global_state)
    if [ -z "$session" ]; then
        echo "spoken replies, global: $g"
        return
    fi
    read -r state source <<< "$(effective_state "$session")"
    case "$source" in
        session) why="set in this session" ;;
        env)     why="CLAUDE_SPEAK_OFF is set" ;;
        global)  why="follows global" ;;
    esac
    echo "spoken replies, this session: $state ($why); global: $g"
}

case "${1:-stop}" in
    stop)
        if [ "$2" = "--hook" ]; then
            input=$(cat)
            session=$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null | tr -cd 'A-Za-z0-9-')
            prompt=$(printf '%s' "$input" | jq -r '.prompt // empty' 2>/dev/null)
            [ -n "$session" ] || exit 0
            stop_file "$piddir/$session.pid"
            # A /speak command: don't read its own reply out loud.
            if printf '%s' "$prompt" | grep -qE '^[[:space:]]*/(speak-reply:)?speak([[:space:]]|$)'; then
                mkdir -p "$piddir" && touch "$piddir/$session.skip"
            fi
        else
            stop_all; echo "spoken replies: stopped"
        fi ;;
    off)
        need_session; stop_file "$piddir/$session.pid"; set_session off; status ;;
    on)
        set_session on; status ;;
    global)
        case "$2" in
            off) stop_all; touch "$muteflag"; status ;;
            on)  rm -f "$muteflag"; status ;;
            *)   echo "usage: claude-speak global on|off" >&2; exit 2 ;;
        esac ;;
    status) status ;;
    *)  echo "usage: claude-speak [stop|on|off|global on|global off|status]" >&2; exit 2 ;;
esac
exit 0
